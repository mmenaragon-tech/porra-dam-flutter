class TarjetaPartido extends StatelessWidget {
  final Partido partido;
  const TarjetaPartido({super.key, required this.partido});

  Widget _fila(Equipo equipo, int? goles) {
    return Row(
      children: [
        Expanded(child: TarjetaEquipo(equipo: equipo)),
        Text(
          '$goles',
          style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
        ),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        _fila(partido.local, partido.golesLocal),
        const SizedBox(height: 8),
        _fila(partido.visitante, partido.golesVisitante),
      ],
    );
  }
}

class TarjetaResultado extends StatelessWidget {
  final Partido partido;
  final Usuario usuario;
  const TarjetaResultado({super.key, required this.partido, required this.usuario});

  Porra? get porra {
    for (final p in usuario.porras) {
      if (p.partido.local.nombre == partido.local.nombre &&
          p.partido.visitante.nombre == partido.visitante.nombre) {
        return p;
      }
    }
    return null;
  }

  int get puntos => porra?.puntosContra(partido) ?? 0;

  @override
  Widget build(BuildContext context) {
    
    final puntos = this.puntos;
    final porra = this.porra;

    final Color fondo;
    final Color texto;
    if (porra == null) {
      // Sin porra: neutro, para no confundirlo con un fallo
      fondo = Colors.grey.shade200;
      texto = Colors.black54;
    } else if (puntos == 0) {
      fondo = Colors.red.shade50;
      texto = Colors.red.shade600;
    } else if (puntos >= 8) {
      fondo = Colors.green.shade100;
      texto = Colors.green.shade700;
    } else {
      fondo = Colors.grey.shade200;
      texto = Colors.black54;
    }

    final textoPorra = porra == null
        ? 'Sin porra'
        : 'Tu porra: ${porra.golesLocal} - ${porra.golesVisitante}';

    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 12),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.center,
        children: [
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                TarjetaPartido(partido: partido),
                const SizedBox(height: 8),
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                  decoration: BoxDecoration(
                    color: fondo,
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: Text(
                    textoPorra,
                    style: TextStyle(
                      fontSize: 11,
                      fontWeight: FontWeight.w500,
                      color: texto,
                    ),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(width: 16),
          Container(
            width: 56,
            height: 56,
            alignment: Alignment.center,
            decoration: BoxDecoration(
              color: fondo,
              borderRadius: BorderRadius.circular(14),
            ),
            child: Text(
              puntos > 0 ? '+$puntos' : '$puntos',
              style: TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.bold,
                color: texto,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
